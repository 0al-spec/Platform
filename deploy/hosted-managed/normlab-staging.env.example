# Keep this in /etc/0al/normlab-staging.env, separate from the Platform
# production environment inventory. Never store the operator password here.
PLATFORM_NORMLAB_IMAGE=ghcr.io/soundblaster/normlab@sha256:<digest>
PLATFORM_NORMLAB_OPERATOR_PASSWORD_FILE=/srv/0al/secrets/normlab-operator-password
PLATFORM_NORMLAB_OPERATOR_USERNAME=operator
# Optional inference overlays: these are non-secret settings, never key values.
PLATFORM_NORMLAB_OPENAI_MODEL=gpt-6-luna
PLATFORM_NORMLAB_OPENAI_BASE_URL=https://api.openai.com/v1
PLATFORM_NORMLAB_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# CoreInfra override; its key goes in the OpenAI-compatible provider secret file:
# PLATFORM_NORMLAB_OPENAI_BASE_URL=https://hub.coreinfra.ai/codex/api/v1
PLATFORM_NORMLAB_TYPESAFE_MODEL=jev-1.13.0
PLATFORM_NORMLAB_INFERENCE_REQUESTS_PER_HOUR=6
